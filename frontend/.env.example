# ============================================
# TALENT-IQ Frontend Environment Variables
# ============================================

# Clerk Authentication (REQUIRED)
# Sign up at: https://clerk.com
# 1. Create new application
# 2. Copy Publishable Key from dashboard
# 3. Paste below
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Backend API URL (REQUIRED)
# Default for local development
VITE_API_URL=http://localhost:5000/api

# Stream SDK - Video & Chat (REQUIRED for video calls and chat)
# Sign up at: https://getstream.io
# 1. Create new application
# 2. Go to Dashboard → Your App
# 3. Copy "App Key" (NOT the secret)
# 4. Paste below (should start with your app ID)
VITE_STREAM_API_KEY=your_stream_api_key_here

# Notes:
# - Never commit .env file to version control
# - Copy this file to .env and fill in your actual values
# - Restart dev server after changing environment variables
