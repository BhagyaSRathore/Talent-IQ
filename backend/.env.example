# ============================================
# TALENT-IQ Backend Environment Variables
# ============================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (REQUIRED)
# Get from: https://www.mongodb.com/cloud/atlas
# 1. Create free cluster
# 2. Create database user
# 3. Whitelist IP (0.0.0.0/0 for development)
# 4. Get connection string and replace <password>
DB_URL=mongodb+srv://username:password@cluster.mongodb.net/talentiq?retryWrites=true&w=majority

# DNS Server Override (Automatic - Only change if needed)
# If MongoDB connection fails with ECONNREFUSED on SRV lookups,
# this is automatically fixed by the app using Google DNS (8.8.8.8).
# Only set this if you need a different DNS server.
# DNS_SERVER=8.8.8.8

# JWT Secret (REQUIRED)
# Generate a secure random string (minimum 32 characters)
# Example: openssl rand -hex 32
JWT_SECRET=your_secure_random_jwt_secret_change_this_minimum_32_chars

# Clerk Authentication (REQUIRED)
# Get from: https://clerk.com
# 1. Create application
# 2. Go to Dashboard → API Keys
# 3. Copy both Publishable and Secret keys
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Stream SDK - Video & Chat (REQUIRED for video/chat features)
# Get from: https://getstream.io
# 1. Create application
# 2. Go to Dashboard → Your App → Credentials
# 3. Copy both Key and Secret
# WARNING: Keep the Secret secure, never expose to frontend
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

# Frontend URL (REQUIRED for CORS)
CLIENT_URL=http://localhost:5173

# Judge0 Code Execution (Optional - enables code running)
# Get from: https://rapidapi.com/judge0-official/api/judge0-ce
# 1. Subscribe to Judge0 CE API (free tier available)
# 2. Copy your RapidAPI key
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
RAPIDAPI_KEY=your_rapidapi_key_here

# Inngest (Optional - for background jobs/webhooks)
# Get from: https://inngest.com
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# Notes:
# - Never commit .env file to version control
# - Copy this file to .env and fill in your actual values
# - Restart server after changing environment variables
# - Use different values for production
